# Copy this file to .env (repo root) and fill in real values.
# .env is git-ignored — never commit real credentials.
#
# Both backend/main.py and bot/app/bot.py load this file automatically
# (python-dotenv walks up from its own directory until it finds a .env),
# so a single .env at the repo root is enough for both services.

# --- PostgreSQL ---
# Used by backend/ and bot/ to persist patients, sessions and posture metrics.
DATABASE_URL=postgresql://user:password@localhost:5432/shpd_db

# --- Telegram Bot ---
# Token from @BotFather. Required by both backend/main.py (sends alerts)
# and bot/app/bot.py (the interactive bot).
TELEGRAM_TOKEN=your-telegram-bot-token

# --- OpenAI ---
# Used by backend/main.py to classify posture from a frame via GPT-4o-mini vision.
# Only required when POSTURE_CLASSIFIER=openai (see below).
OPENAI_API_KEY=your-openai-api-key

# --- Posture classifier ---
# Which mechanism backend/main.py uses to classify the 12 fine-grained
# postures once a bad-posture streak crosses the alert threshold:
#   local  -> the TFLite model trained in shpd-edge-vision, run on the
#             MediaPipe landmarks of that frame. Default; doesn't need
#             OPENAI_API_KEY.
#   openai -> GPT-4o-mini (vision) on the JPEG frame, as before. Explicit
#             alternative, kept for comparing against the local model.
# Unrecognized values fall back to "local" (with a warning logged).
POSTURE_CLASSIFIER=local

# --- Frontend ---
# Host the bot links to in the "Ver monitoreo en vivo" message. On the
# Raspberry Pi this is http://rodo.local:3000; for local PC testing use
# http://localhost:3000.
FRONTEND_URL=http://rodo.local:3000
